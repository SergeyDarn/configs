{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "palette": {
        "os": "#ACB0BE",
        "closer": "p:os",
        "accent": "#fab387",
        "lavender": "#B4BEFE",
        "blue": "#89B4FA"
    },
    "blocks": [
        {
            "alignment": "left",
            "type": "prompt",
            "segments": [
                {
                    "foreground": "p:accent",
                    "options": {
                        "folder_icon": "",
                        "home_icon": "~",
                        "style": "full"
                    },
                    "style": "plain",
                    "template": "{{ .Path }} ",
                    "type": "path"
                },
                {
                    "foreground": "p:lavender",
                    "options": {
                        "branch_icon": " ",
                        "cherry_pick_icon": " ",
                        "commit_icon": " ",
                        "merge_icon": " ",
                        "no_commits_icon": " ",
                        "rebase_icon": " ",
                        "revert_icon": " ",
                        "tag_icon": " "
                    },
                    "template": "{{ .HEAD }} ",
                    "style": "plain",
                    "type": "git"
                },
                {
                    "style": "plain",
                    "foreground": "p:closer",
                    "template": "",
                    "type": "text"
                }
            ]
        }
    ],
    "final_space": true,
    "version": 4
}
